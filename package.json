{
  "name": "kolekto",
  "private": true,
  "version": "0.0.0",
  "description": "Kolekto — the financial operating system for communities.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "lint": "npm run lint --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm run test --workspace packages/domain",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/db/reset.mjs",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "test:e2e": "playwright test",
    "invariants": "node scripts/invariants/run-all.mjs",
    "verify": "npm run typecheck && npm run invariants && npm run test",
    "db:migrate": "supabase migration up --local",
    "db:backup": "node scripts/db/backup.mjs",
    "db:restore": "node scripts/db/restore.mjs",
    "db:marker": "node scripts/db/persistence-marker.mjs",
    "test:concurrency": "node scripts/verify/reference-concurrency.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.6.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "fontkit": "^2.0.4",
    "typescript": "^5.7.0"
  }
}
