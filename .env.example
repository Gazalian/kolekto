# ─────────────────────────────────────────────────────────────────────────────
# Kolekto — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and must NEVER
# contain production values. Production secrets live only in the hosting
# provider's secret store (docs/adr/0007-environment-isolation.md).
#
# The app refuses to start if a required variable is missing. It never falls
# back to a default, because a silent default is how a fresh clone ends up
# talking to production.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process believes it is. One of: local | staging | production
# Guards in packages/config assert that non-production builds are not pointed at
# the production project ref.
KOLEKTO_ENV=local

# ── Supabase ────────────────────────────────────────────────────────────────
# Local (`supabase start`) prints these. For a cloud project, take them from
# Project Settings → API. NEVER put a service-role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. `supabase start` prints this too. Server only —
# used by @kolekto/db to call the `app` schema's write functions, which
# PostgREST does not expose (see @kolekto/config's loadDatabaseUrl). NEVER a
# NEXT_PUBLIC_ var.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The production project ref. Set so non-production code can assert it is NOT
# talking to production and fail loudly if it is. Carried from the old repo's
# integration-test guard, generalised.
#
# NOTE: this means the NEW system's production project, which does not exist yet.
# The LEGACY production project (`busfgcmbndleljklrcbd`) is a different system,
# is live, and must never be connected to from here at all — not read, not
# written, not linked. docs/phase-4/environments.md names every project in play
# and says which may be touched.
KOLEKTO_PRODUCTION_PROJECT_REF=

# The hosted project this process is meant to use. REQUIRED when KOLEKTO_ENV is
# `staging`: packages/config refuses to start unless it equals the ref in
# NEXT_PUBLIC_SUPABASE_URL — two settings that must agree, so a mistyped or
# copied URL fails at startup instead of connecting somewhere unexpected.
# Leave empty for local: KOLEKTO_ENV=local only ever accepts this machine.
# Staging is kwolxuoeqwuedydxzncb (docs/environments/staging.md).
#
# Independently of every variable here, packages/config refuses BOTH legacy
# projects (busfgcmbndleljklrcbd, lpeeckqsltxohppheucz) in every environment.
KOLEKTO_EXPECTED_PROJECT_REF=

# ── Contributor sessions ─────────────────────────────────────────────────────
# NOTE: the Next.js app reads apps/web/.env.local, not this directory's .env.local.
# Anything the web app needs at runtime has to be in BOTH, or it is missing only
# on the code path that uses it.
#
# Signs the cookie that remembers which member a contributor identified as on a
# public collection page. Server only. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KOLEKTO_SESSION_SECRET=

# ── Paystack ────────────────────────────────────────────────────────────────
# NOT USED YET. Nothing in the codebase reads these: M8.2 built the provider
# boundary and a deterministic offline fake, and the real adapter is M8.9.
#
# TEST KEYS ONLY, in local AND in staging. Staging is publicly reachable and will
# have a real webhook pointed at it, so a live key there would move real money
# from a non-production deployment.
#
# NEVER reuse a key, webhook secret, callback URL, subaccount or split
# configuration from the legacy system. The legacy environment is live and must
# stay untouched; the new system gets its own separately provisioned Paystack
# configuration. See docs/phase-4/environments.md.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Where a contributor is returned after checkout. A hint for the receipt, never
# evidence that a payment succeeded — that comes only from verify().
PAYSTACK_CALLBACK_URL=

# ── Notifications ───────────────────────────────────────────────────────────
# NOT USED YET. Provider selection is DEC-17.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
