# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.next-e2e/
out/
*.tsbuildinfo

# Next.js type-reference stub. Regenerated by `next dev`/`next build`, with
# import paths that differ between modes (`.next/types/*` under `next build`
# vs `.next/dev/types/*` under Turbopack dev), so tracking it produces a
# recurring working-tree change after every local build. Narrowly scoped —
# apps/web is the only Next.js app in this monorepo.
apps/web/next-env.d.ts

# Environment — NOTHING but the example is ever committed.
# See docs/adr/0007-environment-isolation.md
.env
.env.*
!.env.example

# Supabase CLI local state. `supabase/.temp/linked-project.json` was tracked in
# kolekto-be-old from 2026-08-06 to 2026-08-31 and pointed a fresh clone at the
# PRODUCTION project. It never happens again.
supabase/.temp/
supabase/.branches/

# Logs, OS, editor
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test output
coverage/
playwright-report/
test-results/

# Local scratch
/tmp/
*.local

# Local database snapshots (npm run db:backup). Never committed: they contain
# whatever the developer created locally, including their sign-in row.
backups/
